<IfModule mod_rewrite.c>
    RewriteEngine On

# Canonical host per brand (match BRAND_*_HOST in .env / config/brands.php)
    RewriteCond %{HTTP_HOST} ^www\.masharikigroup\.org$ [NC]
    RewriteRule ^ https://masharikigroup.org%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.masharikiacademy\.org$ [NC]
    RewriteRule ^ https://masharikiacademy.org%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.masharket\.com$ [NC]
    RewriteRule ^ https://masharket.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^masharikifestival\.org$ [NC]
    RewriteRule ^ https://www.masharikifestival.org%{REQUEST_URI} [L,R=301]

# Deny direct web access to app source/config/storage (app is deployed at doc root)
<IfModule mod_authz_core.c>
  <FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|README\.md|CHANGELOG\.md|vite\.config\.js|postcss\.config\.js|\.env.*)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|README\.md|CHANGELOG\.md|vite\.config\.js|postcss\.config\.js|\.env.*)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Serve the public storage disk (uploaded images) through the conventional
# /storage/... URL Laravel's asset()/Storage::url() helpers generate, even
# though "storage/" is blocked below — that blanket rule exists to protect
# storage/framework, storage/logs, and storage/app/private, not the
# intentionally-public storage/app/public subtree. Must come before the
# blanket deny rule so this takes priority for uploaded files. The
# RewriteCond guards against a rewrite loop: [L] in .htaccess context
# restarts rule matching from the top with the new URI, so without this
# guard the already-rewritten storage/app/public/X path would match this
# same rule again and get "app/public/" prepended a second time, looping
# until Apache's internal redirect limit trips a 500.
RewriteCond %{REQUEST_URI} !^/storage/app/public/
RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
RewriteRule ^storage/(.+)$ /storage/app/public/$1 [L]

# The negative lookahead on "storage" below is the other half of the fix
# above: after the rewrite restarts matching with the new
# storage/app/public/... URI, this rule would otherwise still match on
# "storage/" and forbid the very file we just allowed through.
RewriteRule ^(app|bootstrap|config|database|resources|routes|storage(?!/app/public/)|tests|vendor|node_modules)/ - [F,L]

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
